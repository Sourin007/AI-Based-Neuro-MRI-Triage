# ---------------------------------------------------------------------------
# Copy to .env and fill in. .env is git-ignored and never baked into the image.
# ---------------------------------------------------------------------------

# --- Deployment environment ---------------------------------------------------
# "development" or "production". In production, CORS_ALLOW_ORIGINS is required
# and must not be "*".
ENVIRONMENT=development

# --- API security / serving ---------------------------------------------------
# Comma-separated list of allowed browser origins (the frontend URL[s]).
# Dev default (if unset) is the local Vite server. In production set this to your
# deployed frontend, e.g. https://your-app.vercel.app
CORS_ALLOW_ORIGINS=

# Max accepted upload size in megabytes.
MAX_UPLOAD_MB=15

# Rate limit for POST /analyze (slowapi syntax), e.g. "10/minute", "100/hour".
ANALYZE_RATE_LIMIT=10/minute

# --- Observability ------------------------------------------------------------
# Sentry DSN for error tracking. Leave blank to disable.
SENTRY_DSN=
LOG_LEVEL=INFO
# "true" for JSON logs (recommended in production), "false" for console-friendly.
JSON_LOGS=true

# --- Optional LLM (enables real LLM reasoning; falls back to rules if unset) ---
OPENAI_API_KEY=

# --- ML pipeline tuning (all optional; sensible defaults in brain_tumor_ai) ----
# BTD_CONFIDENCE_THRESHOLD=0.78
# BTD_MAX_REVIEW_LOOPS=2
# BTD_LLM_PROVIDER=openai
# BTD_LLM_MODEL=gpt-4o-mini
# BTD_RETRIEVAL_K=4
